{
  "name": "jewelleryweb",
  "version": "1.0.0",
  "description": "Aura Atelier Luxury Jewellery E-Commerce Platform",
  "scripts": {
    "dev": "concurrently -k -n FRONTEND,BACKEND -c cyan.bold,yellow.bold \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev -- --host 127.0.0.1 --port 5173",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "python test_suite.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
